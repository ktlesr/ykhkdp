{
  "name": "@ykh/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./migrate": "./src/migrate.ts",
    "./seed": "./src/seed.ts"
  },
  "scripts": {
    "migrate": "node --env-file-if-exists=../../.env src/cli.ts up",
    "migrate:down": "node --env-file-if-exists=../../.env src/cli.ts down",
    "seed": "node --env-file-if-exists=../../.env src/cli.ts seed",
    "reset": "node --env-file-if-exists=../../.env src/cli.ts reset",
    "test": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.test --test src/*.test.ts",
    "nace": "node --env-file-if-exists=../../.env src/cli.ts nace",
    "belgeler": "node --env-file-if-exists=../../.env src/cli.ts belgeler"
  },
  "dependencies": {
    "@ykh/domain": "workspace:*",
    "@ykh/scoring": "workspace:*",
    "postgres": "3.4.9"
  }
}
