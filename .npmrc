# Üç test paketi de aynı test veritabanını `sifirla()` ile sıfırlıyor. Paralel
# çalışırlarsa biri diğerinin şemasını ortasında siler. Testler zaten gerçek
# model çağrısı yaptığı için paralellik kazanç sağlamıyor — sıraya alıyoruz.
#
# ponytail: süreç başına ayrı veritabanı daha hızlı olurdu; test süresi
# rahatsız edici olursa `DATABASE_URL_OWNER`'a paket adı eklenir.
workspace-concurrency=1
