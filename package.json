{
  "name": "ykhkdp",
  "version": "0.1.0",
  "private": true,
  "description": "YKH — Yerel Kalkınma Hamlesi yatırım konusu önerileri",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:migrate": "pnpm --filter @ykh/database migrate",
    "db:seed": "pnpm --filter @ykh/database seed",
    "db:reset": "pnpm --filter @ykh/database reset",
    "dev": "pnpm --filter @ykh/web dev",
    "worker": "pnpm --filter @ykh/worker start",
    "build": "pnpm --filter @ykh/web build",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "typecheck": "pnpm --filter @ykh/web typecheck",
    "audit": "pnpm audit --prod",
    "ai:test": "pnpm --filter @ykh/ai-gateway sinama",
    "db:belgeler": "pnpm --filter @ykh/database belgeler"
  },
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=22.18"
  }
}
