# ── YKH-KDP · üretim ortam değişkenleri ─────────────────────────────────────
#
# Bu dosya ÖRNEKTİR. Gerçek değerler Dokploy panelinde "Environment" sekmesine
# girilir, depoya HİÇ yazılmaz. Adım adım anlatım: docs/ykh-dagitim.md
#
# ═══ VERİTABANI DOKPLOY'DA, BU COMPOSE'DA DEĞİL ════════════════════════════
#
# `docker-compose.production.yml` üç servis kuruyor (kurulum · web · worker).
# Postgres YOK: Dokploy'un kendi PostgreSQL servisi kullanılıyor, böylece
# yedekleme ve izleme onun panelinden yönetiliyor.
#
# Bağlantı adresi aşağıdaki parçalardan TEK YERDEN kuruluyor:
#
#   DATABASE_URL_OWNER = postgres://SAHIP:POSTGRES_PAROLA@SUNUCU:PORT/AD
#   DATABASE_URL       = postgres://ykh_app:YKH_APP_PAROLA@SUNUCU:PORT/AD
#
# Aynı sunucu, aynı veritabanı; adresi iki kez yazmıyorsunuz, yazım hatası
# ihtimali yok. İkisini doğrudan vermek isterseniz en alttaki bölüme bakın.

# ══ 1 · DOKPLOY'DAKİ VERİTABANI ════════════════════════════════════════════
# Bu dört değer Dokploy → Databases → (servisiniz) ekranından okunur.

# Servisin İÇ ana makine adı. Dokploy'un gösterdiği "Internal Connection URL"
# içinde `@` ile `:5432` arasında kalan kısım. Sunucunun IP'si DEĞİL.
YKH_DB_SUNUCU=

# Veritabanı adı ("Database Name").
YKH_DB_ADI=

# Veritabanı kullanıcı adı ("Database User"). Genelde `postgres`.
# Bu kullanıcı `create role` ve `create extension` yapabilmeli — Dokploy'un
# oluşturduğu kullanıcı superuser'dır, yapabilir.
YKH_DB_SAHIP=

# O kullanıcının parolası ("Database Password") — Dokploy'un ürettiği değer.
# YALNIZCA HARF VE RAKAM OLMALI. Parola bağlantı adresinin içine giriyor;
# `/` adresi ayrıştırılamaz yapıyor, `@` ana makine adını kaydırıyor. Dokploy
# özel karakterli bir parola ürettiyse o ekrandan değiştirin. Kurulum bunu
# kontrol ediyor ve bozuksa açık bir hatayla duruyor.
POSTGRES_PAROLA=

# Standart dışı port kullanıyorsanız. Boş bırakılırsa 5432.
# YKH_DB_PORT=5432

# ══ 2 · UYGULAMA ROLÜ ══════════════════════════════════════════════════════
# Bu parolayı SİZ üretiyorsunuz:  openssl rand -hex 24
#
# `ykh_app` rolünü migration `ykh_app_parola` sabitiyle açıyor ve o parola
# herkese açık depoda yazılı. Kurulum ilk iş olarak burada verdiğinizle
# değiştirir. Varsayılan bırakılırsa, harf/rakam dışı karakter içerirse ya da
# 24 karakterden kısaysa kurulum başlamadan hata verir.
#
# Web ve worker YALNIZCA bu rolü görür: superuser değil, tablo sahibi değil,
# BYPASSRLS taşımıyor. Satır güvenliğinin uygulandığı tek yol bu.
YKH_APP_PAROLA=

# ══ 3 · İLK YÖNETİCİ HESABI ════════════════════════════════════════════════
# Kurulumda bir kez açılır. Zaten varsa dokunulmaz, parola sıfırlanmaz.
# Bu VERİTABANI parolası değil — /giris ekranına yazacağınız parola.
YKH_YONETICI_EPOSTA=
YKH_YONETICI_PAROLA=
YKH_YONETICI_AD=Yönetici

# ══ 4 · ÜST ÖLÇEKLİ BELGELER ═══════════════════════════════════════════════
# İLK kurulumda `evet`, sonra `hayir`. Yeniden yükleme `belge.id` değiştirir ve
# eski değerlendirmelerin atıf adresleri eskir (alıntı METNİ durur).
YKH_KUR_BELGELER=hayir

# ══ 5 · SİTE ADRESİ ════════════════════════════════════════════════════════
# Alan adınız, şema dahil. WhatsApp, LinkedIn, X, Facebook ve Telegram
# paylaşımlarında görünen kart ile `sitemap.xml` bu adrese göre kuruluyor.
# VERİLMEZSE kartlar `localhost` adresine bakar ve hiçbir yerde görünmez;
# site çalışmaya devam eder, yalnızca paylaşımlar bozulur.
YKH_SITE_URL=https://ykh.kurumun.gov.tr

# ══ 6 · YAPAY ZEKÂ ═════════════════════════════════════════════════════════
# BOŞ BIRAKILABİLİR. Anahtar yoksa çevrimdışı deterministik istemci devreye
# girer: doğrulama zinciri aynen çalışır, puanlar ve NACE eşleşmesi kaba olur.
OPENAI_API_KEY=

# Pinli model künyesi. Boş bırakılırsa gpt-4.1-2025-04-14 kullanılır.
# `latest` YASAK — hem uygulama hem veritabanı kısıtı reddeder.
YKH_MODEL_SNAPSHOT=

# ══ 7 · WORKER VE LOG ══════════════════════════════════════════════════════
# Kuyruk boşken bekleme (ms). Düşürmek model maliyetini artırır.
YKH_WORKER_ARALIK=5000

# debug | info | uyari | hata
YKH_LOG_SEVIYE=info

# ══ 8 · GELİŞMİŞ · normalde GEREKMEZ ═══════════════════════════════════════
# Bağlantı adresini yukarıdaki parçalardan kurmak yerine doğrudan vermek
# isterseniz (ör. `?sslmode=require` eklemek için) bu ikisini doldurun; dolu
# olanlar parçalardan kurulanı ezer. Doldurursanız İKİSİNİ BİRDEN doldurun —
# biri parçalardan, diğeri elden gelirse ikisi farklı veritabanına bakabilir.
# DATABASE_URL_OWNER=
# DATABASE_URL=
