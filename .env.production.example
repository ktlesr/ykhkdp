# ── YKH-KDP · üretim ortam değişkenleri ─────────────────────────────────────
#
# Bu dosya ÖRNEKTİR. Gerçek değerler Dokploy panelinde "Environment" sekmesine
# girilir, depoya HİÇ yazılmaz. Adım adım anlatım: docs/ykh-dagitim.md
#
# Parolaları üret:  openssl rand -hex 24
#
# `-hex` ŞART, `-base64` DEĞİL: base64 alfabesi `/` `+` `=` içeriyor ve parola
# bağlantı adresinin içine giriyor (postgres://ykh_app:PAROLA@postgres:5432/…).
# `/` o adresi ayrıştırılamaz yapıyor — ölçüldü. Kurulum bozuk biçimli parolayı
# reddediyor, sessizce bağlanamayan bir üretim doğmuyor.

# ── veritabanı ──────────────────────────────────────────────────────────────
# Şema sahibi. Yalnızca `kurulum` servisi kullanır; RLS'i baypas eder.
POSTGRES_PAROLA=

# Uygulama rolü. Web ve worker YALNIZCA bunu görür; RLS uygulanır.
# Migration rolü `ykh_app_parola` sabitiyle açıyor ve o parola depoda yazılı —
# kurulum adımı ilk iş olarak burada verdiğinizle değiştirir. Varsayılan
# bırakılırsa, harf/rakam dışı karakter içerirse ya da 24 karakterden kısaysa
# kurulum başlamadan hata verir.
YKH_APP_PAROLA=

# ── ilk yönetici hesabı ─────────────────────────────────────────────────────
# Kurulumda bir kez açılır. Zaten varsa dokunulmaz.
YKH_YONETICI_EPOSTA=
# En az 12 karakter. Bu VERİTABANI parolası değil — /giris ekranına yazacağınız
# parola. `openssl rand -hex 24` çıktısını kullanabilirsiniz.
YKH_YONETICI_PAROLA=
YKH_YONETICI_AD=Yönetici

# ── üst ölçekli belgeler ────────────────────────────────────────────────────
# İLK kurulumda `evet`, sonra `hayir`. Yeniden yükleme `belge.id` değiştirir ve
# eski değerlendirmelerin atıf adresleri eskir (alıntı METNİ durur).
YKH_KUR_BELGELER=hayir

# ── AI ──────────────────────────────────────────────────────────────────────
# Boşsa çevrimdışı deterministik istemci çalışır; doğrulama zinciri aynıdır
# ama puanlar ve NACE eşleşmesi kaba olur.
OPENAI_API_KEY=
# Pinli model. `latest` hem uygulamada hem veritabanı kısıtında reddedilir.
YKH_MODEL_SNAPSHOT=

# ── worker ve log ───────────────────────────────────────────────────────────
YKH_WORKER_ARALIK=5000
YKH_LOG_SEVIYE=info
