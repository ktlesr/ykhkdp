# ── YKH-KDP · üretim ortam değişkenleri ─────────────────────────────────────
#
# Bu dosya ÖRNEKTİR. Gerçek değerler Dokploy panelinde "Environment" sekmesine
# girilir, depoya HİÇ yazılmaz. Adım adım anlatım: docs/ykh-dagitim.md
#
# ═══ VERİTABANI DOKPLOY'DA, BU COMPOSE'DA DEĞİL ════════════════════════════
#
# `docker-compose.production.yml` üç servis kuruyor (kurulum · web · worker).
# Postgres YOK: Dokploy'un kendi PostgreSQL servisi kullanılıyor, böylece
# yedekleme ve izleme onun panelinden yönetiliyor.
#
# COMPOSE HİÇBİR ŞEY TÜRETMİYOR. Dokploy `${AD:-varsayilan}` biçimini
# çözemiyor (ölçüldü: `DATABASE_URL` boş geldi ve uygulama durdu), o yüzden
# compose dosyasında hiç varsayılan yok. Aşağıdaki her değeri TAM yazın.
#
# Eksik ya da tutarsız yapılandırmayı uygulama yakalıyor ve ne yapılacağını
# yazıyor — sessizce yanlış çalışmıyor.

# ══ 1 · VERİTABANI ADRESLERİ ═══════════════════════════════════════════════
#
# İKİSİNİ DE TAM YAZIN. Compose hiçbir şey türetmiyor — bkz. dosyanın başındaki
# not: Dokploy `${AD:-varsayilan}` biçimini çözemiyor, o yüzden bu dosyada hiç
# varsayılan yok. Ne verirseniz o gider.
#
# Dokploy → Databases → servisiniz → "Internal Connection URL" değerini
# olduğu gibi DATABASE_URL_OWNER'a yapıştırın:

DATABASE_URL_OWNER=postgres://ykhadmin:PAROLA@ykhkdp-db-a1b2c3:5432/ykhkdp_db

# Sonra AYNI adresi, yalnızca kullanıcı ve parolayı değiştirerek:
#
#   kullanıcı  →  ykh_app          (birebir bu, başka bir şey OLAMAZ)
#   parola     →  YKH_APP_PAROLA   (aşağıdaki §2 ile birebir aynı)
#
# Sunucu, port ve veritabanı adı İKİSİNDE DE AYNI olmalı; farklı olursa şema
# bir yere kurulur, uygulama başka yere bakar.

DATABASE_URL=postgres://ykh_app:YKH_APP_PAROLA@ykhkdp-db-a1b2c3:5432/ykhkdp_db

# UYGULAMA ROLÜ `ykh_app` OLMAK ZORUNDA. Dokploy'un verdiği kullanıcı şema
# sahibidir ve çoğu kurulumda superuser — RLS'i BAYPAS EDER. Sonuç sessizdir:
# sayfalar açılır, hata görünmez, ama her yatırımcı herkesin önerisini görür.
# Uygulama bunu reddediyor.
#
# PAROLADA `/` `@` `:` OLMAMALI: adresi bozar. Dokploy öyle bir parola
# ürettiyse veritabanı ekranından değiştirin (`openssl rand -hex 24`).

# ══ 2 · UYGULAMA ROLÜNÜN PAROLASI ══════════════════════════════════════════
# `openssl rand -hex 24` ile üretin. YUKARIDAKİ DATABASE_URL İÇİNDEKİYLE
# BİREBİR AYNI OLMALI — kurulum `ykh_app` rolünü bununla ayarlıyor, uygulama
# adresteki parolayla bağlanıyor. Ayrışırlarsa kurulum durur ve ikisinin
# uzunluğunu yazar (yaşandı: 48 ve 47 karakter).
#
# `ykh_app` rolünü migration `ykh_app_parola` sabitiyle açıyor ve o parola
# herkese açık depoda yazılı. Kurulum ilk iş olarak bununla değiştirir.
YKH_APP_PAROLA=

# ══ 3 · İLK YÖNETİCİ HESABI ════════════════════════════════════════════════
# Kurulumda bir kez açılır. Zaten varsa dokunulmaz, parola sıfırlanmaz.
# Bu VERİTABANI parolası değil — /giris ekranına yazacağınız parola.
YKH_YONETICI_EPOSTA=
YKH_YONETICI_PAROLA=
YKH_YONETICI_AD=Yönetici

# ══ 4 · ÜST ÖLÇEKLİ BELGELER ═══════════════════════════════════════════════
# İLK kurulumda `evet`, sonra `hayir`. Yeniden yükleme `belge.id` değiştirir ve
# eski değerlendirmelerin atıf adresleri eskir (alıntı METNİ durur).
YKH_KUR_BELGELER=hayir

# ══ 5 · SİTE ADRESİ ════════════════════════════════════════════════════════
# Alan adınız, şema dahil. WhatsApp, LinkedIn, X, Facebook ve Telegram
# paylaşımlarında görünen kart ile `sitemap.xml` bu adrese göre kuruluyor.
# VERİLMEZSE kartlar `localhost` adresine bakar ve hiçbir yerde görünmez;
# site çalışmaya devam eder, yalnızca paylaşımlar bozulur.
YKH_SITE_URL=https://ykh.kurumun.gov.tr

# ══ 6 · YAPAY ZEKÂ ═════════════════════════════════════════════════════════
# BOŞ BIRAKILABİLİR. Anahtar yoksa çevrimdışı deterministik istemci devreye
# girer: doğrulama zinciri aynen çalışır, puanlar ve NACE eşleşmesi kaba olur.
OPENAI_API_KEY=

# Pinli model künyesi. Boş bırakılırsa gpt-4.1-2025-04-14 kullanılır.
# `latest` YASAK — hem uygulama hem veritabanı kısıtı reddeder.
YKH_MODEL_SNAPSHOT=

# ══ 7 · WORKER VE LOG ══════════════════════════════════════════════════════
# Kuyruk boşken bekleme (ms). Düşürmek model maliyetini artırır.
YKH_WORKER_ARALIK=5000

# debug | info | uyari | hata
YKH_LOG_SEVIYE=info

# ══ 8 · UYARI ══════════════════════════════════════════════════════════════
#
# YEREL `.env` DOSYANIZI BURAYA KOPYALAMAYIN.
# Yaşandı: yereldeki `DATABASE_URL=…@localhost:5470/…` satırı üretime taşındı
# ve her sayfa 500 döndü. Konteynerin içinde `localhost` konteynerin kendisi
# demek; veritabanı orada değil. Uygulama artık üretimde yerel adrese
# bağlanmayı reddediyor ve ne yapılacağını yazan bir hata veriyor.
