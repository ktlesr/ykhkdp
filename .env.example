# Veritabanı — iki ayrı bağlantı (bkz. docs/ykh-guvenlik.md §1)
# Uygulama ve worker bunu kullanır; RLS UYGULANIR.
DATABASE_URL=postgres://ykh_app:ykh_app_parola@localhost:5470/ykhkdp
# Yalnızca migration ve seed; RLS baypas eder. Üretimde CI dışında set etmeyin.
DATABASE_URL_OWNER=postgres://ykh_owner:ykh_dev_parola@localhost:5470/ykhkdp

# AI Gateway — anahtar YOKSA çevrimdışı deterministik istemci devreye girer
# ve doğrulama zinciri aynen çalışır.
# OPENAI_API_KEY=
# Pinli model snapshot. 'latest' reddedilir (brief §3).
YKH_MODEL_SNAPSHOT=claude-opus-5-20260101

# Worker
YKH_WORKER_ARALIK=2026
YKH_CIKTI=.data/rapor

# Log
YKH_LOG_SEVIYE=info
