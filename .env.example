# Bu dosyayı `.env` olarak kopyalayın ve OPENAI_API_KEY satırını doldurun.
# `.env` git'e girmez (.gitignore). Kök dizindeki tek dosya; hem web hem worker okur.

# ── AI ──────────────────────────────────────────────────────────────────────
# Anahtar BOŞSA çevrimdışı deterministik istemci devreye girer ve doğrulama
# zinciri aynen çalışır — ama puanlar ve NACE eşleşmesi kaba olur.
OPENAI_API_KEY=

# Pinli model. `latest` reddedilir (uygulama + veritabanı kısıtı).
# Anahtar varsa boş bırakırsanız gpt-4.1-2025-04-14 kullanılır.
# API "model bulunamadı" derse buradan değiştirin.
YKH_MODEL_SNAPSHOT=

# ── Veritabanı ──────────────────────────────────────────────────────────────
# Uygulama ve worker bunu kullanır; RLS UYGULANIR.
DATABASE_URL=postgres://ykh_app:ykh_app_parola@localhost:5470/ykhkdp
# Yalnızca migration ve seed; RLS'i baypas eder.
DATABASE_URL_OWNER=postgres://ykh_owner:ykh_dev_parola@localhost:5470/ykhkdp

# ── Worker ──────────────────────────────────────────────────────────────────
# Kuyruk boşken bekleme süresi (ms).
YKH_WORKER_ARALIK=2000

# ── Log ─────────────────────────────────────────────────────────────────────
# debug | info | uyari | hata
YKH_LOG_SEVIYE=info
